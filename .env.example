# Ambiente: local | test | demo. Em demo, as chaves de Supabase, S3 e Gemini são obrigatórias.
ENV=local
# URL da API (no Supabase: pooler modo transaction, porta 6543).
DATABASE_URL=postgresql+psycopg://confere:confere@localhost:5432/confere
# URL do worker e das migrações (no Supabase: conexão direta ou pooler modo session, porta 5432).
DATABASE_URL_WORKER=postgresql+psycopg://confere:confere@localhost:5432/confere
# Onde guardar arquivos: local (sistema de arquivos) ou supabase (Storage via S3).
STORAGE_BACKEND=local
# Diretório do backend local de arquivos.
STORAGE_LOCAL_DIR=.storage
# Endpoint S3 do Supabase Storage.
S3_ENDPOINT_URL=https://<ref>.supabase.co/storage/v1/s3
# Região do projeto Supabase.
S3_REGION=<regiao-do-projeto>
# Chave de acesso S3 (criada no painel do Supabase). Segredo: nunca versionar.
S3_ACCESS_KEY_ID=
# Segredo da chave S3. Segredo: nunca versionar.
S3_SECRET_ACCESS_KEY=
# Bucket privado dos documentos.
S3_BUCKET=documentos
# Prefixo das chaves: dev/ no local, prod/ na demo.
S3_PREFIX=dev/
# URL do projeto Supabase.
SUPABASE_URL=https://<ref>.supabase.co
# Chave service role: só no backend, nunca no frontend. Segredo.
SUPABASE_SERVICE_ROLE_KEY=
# Chave da API do Gemini. Segredo.
GEMINI_API_KEY=
# Modelo Flash vigente (confirmar o nome).
GEMINI_MODEL=gemini-flash-latest
# Modelo de embeddings vigente (confirmar o nome).
GEMINI_EMBED_MODEL=gemini-embedding-001
# Diretório do cache de respostas do LLM.
LLM_CACHE_DIR=data/llm_cache
# true: só lê o cache; falta no cache vira erro claro.
LLM_OFFLINE=false
# true: habilita o modo de demonstração.
DEMO_MODE=false
# true: usa data/seed42/ptax.csv em vez da API do Banco Central.
PTAX_OFFLINE=false
# URL pública da API, usada pelo frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# DSN do Sentry (opcional).
SENTRY_DSN=
